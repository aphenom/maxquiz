@@ -0,0 +1,56 @@
+{% extends "game/base.html" %}
+{% block title %}{{ space.name }} — Tableau de bord{% endblock %}
+{% block tabs %}{% endblock %}
+{% block content %}
+<style>:root{--orange:{{ space.color_primary }};--vert:{{ space.color_accent }}}
+.bar{height:22px;border-radius:6px;background:var(--sable);overflow:hidden;position:relative}
+.bar>div{height:100%;border-radius:6px;transition:width .8s cubic-bezier(.34,1.56,.64,1)}
+.kpi{flex:1;text-align:center;background:#fff;border-radius:14px;padding:12px 6px;box-shadow:0 1px 4px rgba(34,26,18,.08)}
+.kpi b{font-size:26px;display:block;color:var(--orange)}
+</style>
+<div style="display:flex;align-items:center;gap:10px">
+  <span style="font-size:30px">{{ space.emoji }}</span>
+  <div><h1 style="font-size:24px;margin:0">{{ space.name }}</h1>
+  <p class="small" style="margin:0">Tableau de bord des campagnes · MaxQuiz</p></div>
+</div>
+
+<div style="display:flex;gap:8px;margin-top:14px" class="stagger">
+  <div class="kpi"><b>{{ total }}</b><span class="small">participations</span></div>
+  <div class="kpi"><b>{{ completion }}%</b><span class="small">complétion</span></div>
+  <div class="kpi"><b>{{ consented }}</b><span class="small">contacts consentants</span></div>
+</div>
+<a class="btn vert" href="?export=contacts" style="margin-top:10px">⬇️ Exporter les contacts (CSV)</a>
+
+<h2 style="font-size:18px;margin:22px 0 4px">📉 Connaissance de vos produits</h2>
+<p class="small" style="margin:0 0 10px">Taux de bonne réponse par question — les moins maîtrisées d'abord :
+c'est là que votre communication a le plus d'impact.</p>
+{% for s in quiz_stats %}
+<div class="card" style="margin-bottom:8px;padding:12px 14px">
+  <p style="margin:0 0 6px;font-size:14px;font-weight:600">{{ s.q.text }}</p>
+  <div class="bar"><div style="width:{{ s.pct }}%;background:{% if s.pct < 50 %}var(--rouge){% elif s.pct < 75 %}var(--orange){% else %}var(--vert){% endif %}"></div></div>
+  <p class="small" style="margin:4px 0 0">{{ s.pct }} % de bonnes réponses · {{ s.n }} réponse{{ s.n|pluralize }}</p>
+</div>
+{% empty %}<p class="small">Pas encore de données.</p>{% endfor %}
+
+<h2 style="font-size:18px;margin:22px 0 4px">🗳️ Résultats des sondages</h2>
+{% for s in survey_stats %}
+<div class="card" style="margin-bottom:8px;padding:12px 14px">
+  <p style="margin:0 0 8px;font-size:14px;font-weight:600">{{ s.q.text }} <span class="small">({{ s.n }} réponses)</span></p>
+  {% for d in s.dist %}
+  <p class="small" style="margin:6px 0 2px">{{ d.opt }} — {{ d.pct }} %</p>
+  <div class="bar" style="height:14px"><div style="width:{{ d.pct }}%;background:var(--orange)"></div></div>
+  {% endfor %}
+</div>
+{% empty %}<p class="small">Pas encore de sondage actif.</p>{% endfor %}
+
+<h2 style="font-size:18px;margin:22px 0 4px">🏅 Meilleurs participants</h2>
+{% for s in top %}
+<div class="card" style="display:flex;justify-content:space-between;margin-bottom:6px;padding:10px 14px">
+  <span style="font-weight:700">{{ forloop.counter }}. {{ s.player.pseudo }}
+    {% if s.consent %}<span class="small">📞 {{ s.player.phone|default:"—" }}</span>{% endif %}</span>
+  <span style="font-weight:800;color:var(--orange)">Q{{ s.reached }}</span>
+</div>
+{% endfor %}
+<p class="small" style="margin-top:16px;text-align:center">Seuls les contacts ayant coché la case de
+consentement apparaissent avec leur numéro et dans l'export CSV.</p>
+{% endblock %}

# Copier vers /etc/maxquiz.env (chmod 600) puis remplir.
DEBUG=False
SECRET_KEY=remplacer-par-une-longue-cle-aleatoire
ALLOWED_HOSTS=maxquiz.mondomaine.ci
CSRF_TRUSTED_ORIGINS=https://maxquiz.mondomaine.ci
# SQLite par défaut (fichier db.sqlite3 dans le dossier du projet).
# Pour PostgreSQL : DATABASE_URL=postgres://maxquiz:motdepasse@127.0.0.1:5432/maxquiz
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@mondomaine.ci
CRON_TOKEN=remplacer-par-un-jeton-aleatoire
APP_VERSION=1

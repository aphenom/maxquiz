# Copier vers /etc/maxquiz.env (chmod 600) puis remplir.
DEBUG=False
SECRET_KEY=remplacer-par-une-longue-cle-aleatoire
# MaxQuiz École sur maxquiz.net, MaxQuiz Pro sur pro.maxquiz.net (même application).
ALLOWED_HOSTS=maxquiz.net,www.maxquiz.net,pro.maxquiz.net
CSRF_TRUSTED_ORIGINS=https://maxquiz.net,https://www.maxquiz.net,https://pro.maxquiz.net
# MaxQuiz Pro en pause : False affiche « bientôt disponible » sur pro.maxquiz.net.
PRO_ACTIF=False
# Ancien jeu public (défi du jour, portefeuille, classement public) : désactivé.
JEU_PUBLIC_ACTIF=False
# Pas encore de fournisseur SMS : True affiche le code de connexion à l'écran (tests seulement).
OTP_AFFICHER_CODE=False
# Numéro WhatsApp de contact affiché sur la page Pro (format international, ex. 2250700000000).
CONTACT_WHATSAPP=
# SQLite par défaut (fichier db.sqlite3 dans le dossier du projet).
# Pour PostgreSQL : DATABASE_URL=postgres://maxquiz:motdepasse@127.0.0.1:5432/maxquiz
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@maxquiz.net
CRON_TOKEN=remplacer-par-un-jeton-aleatoire
APP_VERSION=1

# Copier vers /etc/maxquiz.env (chmod 600) puis remplir.
DEBUG=False
SECRET_KEY=remplacer-par-une-longue-cle-aleatoire
# MaxQuiz École sur maxquiz.net, MaxQuiz Pro sur pro.maxquiz.net (même application).
ALLOWED_HOSTS=maxquiz.net,www.maxquiz.net,pro.maxquiz.net
CSRF_TRUSTED_ORIGINS=https://maxquiz.net,https://www.maxquiz.net,https://pro.maxquiz.net
# MaxQuiz Pro en pause : False affiche « bientôt disponible » sur pro.maxquiz.net.
PRO_ACTIF=False
# Ancien jeu public (défi du jour, portefeuille, classement public) : désactivé.
JEU_PUBLIC_ACTIF=False
# Pas encore de fournisseur SMS : True affiche le code de connexion à l'écran (tests seulement).
OTP_AFFICHER_CODE=False
# Numéro WhatsApp de contact affiché sur la page Pro (format international, ex. 2250700000000).
CONTACT_WHATSAPP=
# Adresse publique du site (liens dans les notifications et envois à Meta).
SITE_URL=https://maxquiz.net
# Mesure des pubs Meta : identifiant du pixel et jeton de l'API Conversions
# (Gestionnaire d'événements > Paramètres). Vide = aucune donnée envoyée à Meta.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Pour vérifier l'installation (onglet « Tester les événements »), puis à vider.
META_TEST_EVENT_CODE=
# Base MariaDB créée dans ISPConfig (mot de passe en lettres et chiffres) :
# DATABASE_URL=mysql://c1maxquiz:motdepasse@localhost:3306/c1maxquiz
# (installer d'abord : apt install pkg-config default-libmysqlclient-dev build-essential,
#  puis .venv/bin/pip install mysqlclient). Sans DATABASE_URL : SQLite.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@maxquiz.net
CRON_TOKEN=remplacer-par-un-jeton-aleatoire
APP_VERSION=1
# Application Android (TWA) : nom du paquet et empreinte SHA-256 du certificat (zip PWABuilder).
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
# Lien de l'APK proposé aux visiteurs Android sans l'application
# (ex. https://maxquiz.net/telecharger/maxquiz.apk, ou la fiche Play Store plus tard).
APK_URL=
# E-mail de contact affiché sur les pages confidentialité et suppression de compte.
CONTACT_EMAIL=
# Numéros de test, code fixe sans SMS (vérificateurs Google Play, démos) : numero:code,numero:code
OTP_NUMEROS_TEST=

# Signalements d'erreurs et demandes d'assistance : copie par e-mail (facultatif).
# Sans cette ligne, tout arrive seulement dans l'administration (Signalements et assistance).
# SIGNALEMENTS_EMAIL=contact@maxquiz.net
# DEFAULT_FROM_EMAIL=MaxQuiz <noreply@maxquiz.net>

# Lien Google Play, une fois l'application publiée : le bouton « Installer » y mènera.
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=net.maxquiz.twa
